[Unit]
Description=Wyoming Satellite (Wallpanel)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
SupplementaryGroups=audio
WorkingDirectory=/opt/wyoming-satellite
ExecStart=/opt/wyoming-satellite/.venv/bin/wyoming-satellite \
    --name 'Wallpanel' \
    --uri tcp://0.0.0.0:10700 \
    --mic-command 'arecord -D plughw:CARD=PowerConf,DEV=0 -r 16000 -c 1 -f S16_LE -t raw' \
    --snd-command /opt/wyoming-satellite/snd-play.sh \
    --mic-volume-multiplier 4 \
    --mic-auto-gain 4 \
    --mic-noise-suppression 2 \
    --mic-seconds-to-mute-after-awake-wav 1.1 \
    --wake-uri tcp://192.168.178.6:10400 \
    --wake-word-name alexa \
    --awake-wav /opt/wyoming-satellite/sounds/awake.wav \
    --done-wav /opt/wyoming-satellite/sounds/done.wav \
    --timer-finished-wav /opt/wyoming-satellite/sounds/timer_finished.wav
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
